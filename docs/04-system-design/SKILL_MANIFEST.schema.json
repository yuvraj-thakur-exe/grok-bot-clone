{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.invalid/schemas/skill-manifest.schema.json",
  "title": "ORBIT Skill Manifest v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_source",
    "content_sha256",
    "declared_tools",
    "description",
    "immutable_revision",
    "license_expression",
    "name",
    "permissions",
    "review_status",
    "source",
    "version"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "immutable_revision": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "license_expression": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX expression or explicit UNKNOWN; UNKNOWN blocks activation."
    },
    "declared_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "network_hosts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object",
      "required": [
        "tools",
        "filesystem",
        "network",
        "secrets"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filesystem": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "required_secrets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "entrypoint": {
      "type": "string"
    },
    "supported_harnesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "discovered",
        "fetched_quarantined",
        "reviewed",
        "validated",
        "enabled",
        "revoked"
      ]
    },
    "owner": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "canonical_source": {
      "type": "string",
      "format": "uri"
    },
    "attribution": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_runtimes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
