{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.invalid/schemas/ui-spec.schema.json",
  "title": "ORBIT Constrained UI Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","catalog_version","root","elements","actions"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "catalog_version": {"type":"string"},
    "root": {"type":"string"},
    "elements": {
      "type":"object",
      "minProperties":1,
      "maxProperties":80,
      "additionalProperties": {
        "type":"object",
        "additionalProperties":false,
        "required":["type","props"],
        "properties": {
          "type":{"type":"string","pattern":"^[A-Z][A-Za-z0-9]{0,63}$"},
          "props":{"type":"object"},
          "children":{"type":"array","maxItems":40,"items":{"type":"string"}},
          "visible":{"type":"boolean"}
        }
      }
    },
    "actions": {
      "type":"array","maxItems":30,
      "items":{"type":"object","additionalProperties":false,"required":["id","label"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},"label":{"type":"string","maxLength":120},"input_schema":{"type":"object"}}}
    },
    "state":{"type":"object"},
    "security":{"type":"object","additionalProperties":false,"properties":{"allow_html":{"const":false},"allow_eval":{"const":false},"allow_remote_components":{"const":false},"allow_arbitrary_urls":{"const":false}}}
  }
}
