# ORBIT v0.9 local development environment template.
# Copy to .env locally; never commit .env or real credentials.

ORBIT_ENV=development
ORBIT_APP_NAME=ORBIT
ORBIT_LOG_LEVEL=INFO
ORBIT_API_HOST=127.0.0.1
ORBIT_API_PORT=8000
ORBIT_WEB_ORIGIN=http://localhost:3000
ORBIT_PUBLIC_BASE_URL=http://localhost:8000

# Local development only. Use managed secrets or an OS-backed vault outside dev.
DATABASE_URL=postgresql://orbit:orbit_dev_only@localhost:5432/orbit
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=orbit-dev
OBJECT_STORAGE_ACCESS_KEY=replace_me_locally
OBJECT_STORAGE_SECRET_KEY=replace_me_locally
OBJECT_STORAGE_REGION=us-east-1

# Provider secrets are injected into the approved secret manager at runtime.
# Do not place API keys in source control, prompt text, task metadata or logs.
ORBIT_SECRET_BACKEND=development_file
ORBIT_SECRET_MASTER_KEY=replace_with_random_local_only_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Dedicated storage root. Set this to the verified 500 GB drive mount/path.
# Leave ORBIT_UPSTREAM_DIR empty to use $ORBIT_HOME/01-upstream-checkouts.
ORBIT_HOME=
ORBIT_UPSTREAM_DIR=
ORBIT_SOURCE_INTAKE_DIR=
ORBIT_APP_REPO_PATH=
ORBIT_APP_WORKSPACE_DIR=
ORBIT_AUDIT_OUTPUT_DIR=
ORBIT_ENABLE_EXTERNAL_AGENT_BACKENDS=false
ORBIT_ENABLE_SKILL_INSTALLS=false
ORBIT_ENABLE_ROUTINES=false
ORBIT_ENABLE_LOCAL_DESKTOP_NODE=false
ORBIT_ENABLE_UNTRUSTED_PLUGIN_EXECUTION=false

# Worker and safety ceilings. Tune only with reviewed deployment config.
ORBIT_TASK_MAX_STEPS=40
ORBIT_TASK_TIMEOUT_SECONDS=1800
ORBIT_TASK_MAX_COST_USD=2.00
ORBIT_WORKER_MAX_CONCURRENCY=4
ORBIT_BROWSER_DEFAULT_EGRESS=deny
ORBIT_SANDBOX_DEFAULT_EGRESS=deny
ORBIT_SKILL_EXECUTION_MODE=sandbox_only

# Telemetry. Exporters must apply redaction and retention controls.
OTEL_SERVICE_NAME=orbit-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ORBIT_TELEMETRY_INCLUDE_PROMPTS=false
ORBIT_TELEMETRY_INCLUDE_PRIVATE_CONTENT=false

# Storage safety thresholds (decimal GB)
ORBIT_MIN_FREE_GB=60
ORBIT_STORAGE_ALERT_PERCENT=80
ORBIT_STORAGE_BLOCK_PERCENT=90
